---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactCta from '../components/ContactCta.astro';
import recruit from '../data/recruit.json';

const groups = recruit.groups.filter((g) => g.jobs.length > 0);
const hasJobs = groups.length > 0;
---
<Base title="採用情報" description="クリスフードサービス合同会社の採用情報。クリスベーカリー武蔵野店のパート・アルバイト、正社員の募集一覧です。">
  <PageHero title="採用情報" eyebrow="RECRUIT" lead={hasJobs ? recruit.lead : '一緒に働く仲間を探しています。'} crumbs={[{ label: '採用情報' }]} />

  {hasJobs ? (
    <>
      {recruit.airwork?.url && (
        <section class="section">
          <div class="wrap narrow">
            <div class="recruit-main">
              <h2>{recruit.airwork.title}</h2>
              <p>{recruit.airwork.text}</p>
              <a class="btn btn-lg" href={recruit.airwork.url} target="_blank" rel="noopener noreferrer">採用サイトを見る<span class="ext" aria-hidden="true"> ↗</span></a>
            </div>
          </div>
        </section>
      )}

      <section class="section alt">
        <div class="wrap narrow">
          <h2 class="section-title"><small>JOBS</small>募集中の求人</h2>
          {groups.map((g) => (
            <div class="job-group">
              <h3>{g.name}</h3>
              <ul class="job-list">
                {g.jobs.map((j) => (
                  <li class="job">
                    <div class="job-info">
                      <span class="tag">{j.type}</span>
                      <strong>{j.title}</strong>
                      {j.place && <span class="job-place">{j.place}</span>}
                    </div>
                    <a class="btn btn-outline btn-sm" href={j.url} target="_blank" rel="noopener noreferrer">Indeedで見る<span class="ext" aria-hidden="true"> ↗</span></a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <p class="notes">※ 外部サイト（Indeed・Airワーク）が開きます。応募の受付や、募集の状況は、各サイトの表示に従います。</p>
        </div>
      </section>
    </>
  ) : (
    <section class="section">
      <div class="wrap narrow center">
        <p>現在掲載している募集要項はありません。募集を開始した際は、このページでお知らせします。</p>
        <p>ご興味をお持ちの方は、お問い合わせフォームよりお気軽にご連絡ください。</p>
      </div>
    </section>
  )}

  <ContactCta type="recruit" title="採用についてのお問い合わせ" text="求人についてのご質問は、お問い合わせフォームの種別で「採用について」をお選びください。" />
</Base>
