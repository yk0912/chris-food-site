---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { fmtDate } from '../../lib/data';
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="お知らせ" description="クリスフードサービス合同会社からのお知らせ。">
  <PageHero title="お知らせ" eyebrow="NEWS" crumbs={[{ label: 'お知らせ' }]} />
  <section class="section">
    <div class="wrap narrow">
      <ul class="news-list">
        {news.map((n) => (
          <li><a href={`/news/${n.id}/`}><time datetime={n.data.date.toISOString()}>{fmtDate(n.data.date)}</time><span class="tag">{n.data.category}</span><span>{n.data.title}</span></a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
