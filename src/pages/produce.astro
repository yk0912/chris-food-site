---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactCta from '../components/ContactCta.astro';
import { business, img, shops } from '../lib/data';
const p = business.produce;
---
<Base title="ベーカリープロデュース事業" description="ベーカリー、ベーグル専門店、サンドイッチ専門店のプロデュース。商品・製造技術・店舗設計・コンセプトなど、ご要望に応じて対応します。" image={img.producePhoto}>
  <PageHero title="ベーカリープロデュース事業" eyebrow="PRODUCE" lead={p.lead} crumbs={[{ label: '事業紹介', href: '/business/' }, { label: '飲食事業', href: '/food/' }, { label: 'ベーカリープロデュース' }]} image={img.producePhoto} />

  <section class="section">
    <div class="wrap">
      <h2 class="section-title"><small>TARGET</small>対応する業態</h2>
      <div class="grid grid-3">
        {p.targets.map((t) => <div class="plain-card"><h3>{t.name}</h3><p>{t.text}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2 class="section-title"><small>MENU</small>ご要望に合わせて選べる5つのプラン</h2>
      <div class="grid grid-3">
        {p.menus.map((m) => <div class="plain-card"><h3>{m.title}</h3><p>{m.text}</p></div>)}
      </div>
      <p class="center" style="margin-top:24px">「商品のみ」「技術のみ」など、必要な部分だけのご依頼も可能です。</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2 class="section-title" style="text-align:left"><small>STRENGTH</small>自社店舗で培った現場の経験</h2>
        <p>クリスフードサービスは、食パンのお店、サンドイッチ専門店、無人販売所と、異なる形態の{shops.length}店舗を自ら運営しています。</p>
        <p>机上の理論ではなく、実際の製造・販売・店舗運営で得た経験をもとに、小規模なお店でも無理なく続けられる商品づくりと店づくりをご提案します。</p>
        <p><a class="btn btn-outline" href="/bakery/">クリスベーカリーを見る</a></p>
      </div>
      <img src={img.producePhoto} alt="製造の様子" loading="lazy" />
    </div>
  </section>

  <section class="section alt">
    <div class="wrap narrow">
      <h2 class="section-title"><small>FLOW</small>ご依頼の流れ</h2>
      <ol class="steps">{p.flow.map((s) => <li><strong>{s.title}</strong><span>{s.text}</span></li>)}</ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow faq">
      <h2 class="section-title"><small>FAQ</small>よくあるご質問</h2>
      {p.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </section>

  <ContactCta type="produce" title="プロデュースのご相談" text="業態・ご予算・スケジュールなど、まだ漠然としている段階でもお気軽にご相談ください。" />
</Base>
