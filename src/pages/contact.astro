---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site, company } from '../lib/data';
const types = [
  ['bakery', 'ベーカリー（店舗・商品について）'],
  ['produce', 'ベーカリープロデュースのご相談'],
  ['system', 'システム開発のご相談'],
  ['reskilling', 'リスキリング講座のお申込み・ご相談'],
  ['recruit', '採用について'],
  ['other', 'その他'],
];
---
<Base title="お問い合わせ" description="クリスフードサービス合同会社へのお問い合わせ。プロデュース・システム開発・リスキリング講座のご相談はこちらから。">
  <PageHero title="お問い合わせ" eyebrow="CONTACT" lead="ご相談の内容に合わせて、お問い合わせ種別をお選びください。内容を確認のうえ、担当者よりご連絡します。" crumbs={[{ label: 'お問い合わせ' }]} />
  <section class="section">
    <div class="wrap">
      <form class="form" method="POST" action={site.form.endpoint} id="contact-form">
        <div>
          <label for="type">お問い合わせ種別<span class="req">必須</span></label>
          <select id="type" name="お問い合わせ種別" required>
            {types.map(([v, l]) => <option value={l} data-key={v}>{l}</option>)}
          </select>
        </div>
        <div><label for="name">お名前<span class="req">必須</span></label><input id="name" name="お名前" required autocomplete="name" /></div>
        <div><label for="company">会社名・屋号（法人の方）</label><input id="company" name="会社名" autocomplete="organization" /></div>
        <div><label for="email">メールアドレス<span class="req">必須</span></label><input id="email" name="email" type="email" required autocomplete="email" /></div>
        <div><label for="tel">電話番号</label><input id="tel" name="電話番号" type="tel" autocomplete="tel" /></div>
        <div><label for="message">お問い合わせ内容<span class="req">必須</span></label><textarea id="message" name="お問い合わせ内容" required></textarea></div>
        <input class="hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label class="check"><input type="checkbox" required /><span><a href="/privacy/" target="_blank">個人情報保護方針</a>に同意します。</span></label>
        <p class="center"><button class="btn btn-lg" type="submit" id="submit-btn">送信する</button></p>
        <p class="form-error" id="form-error" role="alert" hidden></p>
      </form>
      <div class="form-success" id="form-success" role="status" tabindex="-1" hidden>
        <h2>送信しました</h2>
        <p>お問い合わせありがとうございます。内容を確認のうえ、担当者よりご連絡します。<br />2〜3営業日たっても返信がない場合は、お手数ですがお電話ください。</p>
        <p><a class="btn btn-outline" href="/">トップページへ戻る</a></p>
      </div>
      <p class="center notes" style="margin-top:32px">お急ぎの場合は {company.name}（TEL {company.tel}）までお電話ください。<br />ベーカリー店舗の営業時間中は、お電話に出られない場合があります。</p>
    </div>
  </section>
  <script is:inline>
    (function () {
      var t = new URLSearchParams(location.search).get('type');
      var s = document.getElementById('type');
      if (t && s) {
        var o = s.querySelector('option[data-key="' + t + '"]');
        if (o) s.value = o.value;
      }

      // 送信後にこのページ内で「送信しました」を表示する（Formspree の JSON 送信）
      var form = document.getElementById('contact-form');
      var btn = document.getElementById('submit-btn');
      var err = document.getElementById('form-error');
      var ok = document.getElementById('form-success');
      if (!form || !window.fetch) return; // 古いブラウザは通常のフォーム送信にフォールバック
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        err.hidden = true;
        btn.disabled = true;
        var label = btn.textContent;
        btn.textContent = '送信中…';
        fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
          .then(function (res) {
            if (res.ok) {
              form.hidden = true;
              ok.hidden = false;
              ok.focus();
              ok.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } else {
              throw new Error('status ' + res.status);
            }
          })
          .catch(function () {
            err.textContent = '送信できませんでした。通信状況をご確認のうえ、もう一度お試しください。解決しない場合は、お電話でご連絡ください。';
            err.hidden = false;
            btn.disabled = false;
            btn.textContent = label;
          });
      });
    })();
  </script>
</Base>
