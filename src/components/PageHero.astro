---
interface Props {
  title: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
  image?: string;
  eyebrow?: string;
  theme?: 'corp' | 'bakery';
}
const { title, lead, crumbs = [], image, eyebrow, theme = 'corp' } = Astro.props;
---
<section class={`page-hero ${theme === 'bakery' ? 'is-bakery' : ''} ${image ? 'has-image' : ''}`} style={image ? `--hero:url('${image}')` : undefined}>
  <div class="wrap">
    <nav class="crumbs" aria-label="パンくず">
      <a href="/">トップ</a>
      {crumbs.map((c) => (<><span aria-hidden="true">›</span>{c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</>))}
    </nav>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>
